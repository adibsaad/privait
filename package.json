{
  "name": "privait",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts -w",
    "schema:parity": "node scripts/schema-parity.mjs",
    "format": "prettier --write .",
    "format:frontend": "prettier --write src/frontend",
    "frontend:build": "cd src/frontend && pnpm build",
    "lint": "pnpm lint:frontend",
    "lint:frontend": "cd src/frontend && pnpm lint",
    "lint:fix": "pnpm lint:fix:frontend",
    "lint:fix:frontend": "cd src/frontend && pnpm lint --fix",
    "prepare": "husky",
    "start:frontend": "cd src/frontend && pnpm dev",
    "test": "pnpm test:frontend",
    "test:frontend": "cd src/frontend && pnpm exec vitest run"
  },
  "dependencies": {
    "@0no-co/graphqlsp": "^1.15.2",
    "@eslint/js": "^9.36.0",
    "@graphql-codegen/cli": "^6.1.3",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@parcel/watcher": "^2.5.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1"
  },
  "packageManager": "pnpm@10.17.0",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.3.0"
  },
  "lint-staged": {
    "src/frontend/**/*.{js,jsx,ts,tsx}": [
      "cd src/frontend && eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}