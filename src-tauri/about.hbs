<html>

<head>
  <meta charset="utf-8" />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 2rem;
      line-height: 1.5;
      color: #1a1a1a;
      background: #fff;
    }

    pre {
      background: #f5f5f5;
      padding: 1rem;
      overflow-x: auto;
      white-space: pre-wrap;
    }

    li {
      margin-bottom: 0.25rem;
    }

    hr {
      border: none;
      border-top: 1px solid #ddd;
      margin: 2rem 0;
    }
  </style>
</head>

<body>
  <h3>Third-party licenses</h3>
  <p>
    Privait is licensed under the GNU Affero General Public License v3.0
    (see LICENSE in the project repository). This application incorporates
    third-party software under the licenses below — {{#each overview}}{{#if @index}},
    {{/if}}{{name}} ({{count}}){{/each}}.
  </p>
  <hr />
  {{#each overview}}
  <div>
    <h4 id="{{id}}">{{name}}</h4>
    {{#each indices}}
    <li>{{#with (lookup ../crates this)}}{{package.name}} {{package.version}}{{/with}}</li>
    {{/each}}
    <pre>{{text}}</pre>
    <hr />
  </div>
  {{/each}}
</body>

</html>